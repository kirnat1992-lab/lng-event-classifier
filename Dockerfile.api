# Local demonstration API: trains only on the public, fictional sample at build time.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY lng_event_classifier ./lng_event_classifier
COPY data ./data
RUN python -m lng_event_classifier.train --model-dir artifacts --report-dir /tmp/reports
EXPOSE 8000
CMD ["uvicorn", "lng_event_classifier.api:app", "--host", "0.0.0.0", "--port", "8000"]
